# Copy this file to terraform.tfvars and replace the example values.
# tenant_id is the directory GUID that owns your Azure subscription, even though
# WINSTON uses the Microsoft identity platform's "consumers" endpoint at runtime.

subscription_id      = "00000000-0000-0000-0000-000000000000"
tenant_id            = "00000000-0000-0000-0000-000000000000"
access_request_email = "owner@example.com"
github_repository    = "owner/WINSTON"

allowed_user_object_ids = [
  "00000000-0000-0000-0000-000000000000",
]

# Optional overrides:
# location             = "westus2"
# web_app_name         = "my-unique-winston-app"
# app_service_sku_name = "B1" # Upgrades from the free F1 tier and incurs charges.
# github_environment   = "production"
