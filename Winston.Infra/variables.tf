variable "subscription_id" {
  description = "Azure subscription ID where WINSTON resources will be created."
  type        = string

  validation {
    condition     = can(regex("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$", var.subscription_id))
    error_message = "subscription_id must be an Azure subscription UUID."
  }
}

variable "tenant_id" {
  description = "Microsoft Entra tenant ID that owns the subscription and app registrations."
  type        = string

  validation {
    condition     = can(regex("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$", var.tenant_id))
    error_message = "tenant_id must be a Microsoft Entra tenant UUID."
  }
}

variable "project_name" {
  description = "Short lowercase name used as the prefix for Azure resources."
  type        = string
  default     = "winston"

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{1,15}[a-z0-9]$", var.project_name))
    error_message = "project_name must contain 3-17 lowercase letters, numbers, or hyphens and start with a letter."
  }
}

variable "environment" {
  description = "Environment name included in resource names and tags."
  type        = string
  default     = "dev"

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{1,8}[a-z0-9]$", var.environment))
    error_message = "environment must contain 3-10 lowercase letters, numbers, or hyphens and start with a letter."
  }
}

variable "location" {
  description = "Azure region for the resource group."
  type        = string
  default     = "westus3"
}

variable "allowed_user_object_ids" {
  description = "Microsoft Entra oid claim values for friends permitted to use WINSTON."
  type        = set(string)
  default     = []

  validation {
    condition = alltrue([
      for object_id in var.allowed_user_object_ids :
      can(regex("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$", object_id))
    ])
    error_message = "Every allowed_user_object_ids value must be a UUID."
  }
}

variable "access_request_email" {
  description = "Email address that receives access requests from authenticated users outside the allow-list."
  type        = string

  validation {
    condition     = can(regex("^[^@ ]+@[^@ ]+\\.[^@ ]+$", trimspace(var.access_request_email)))
    error_message = "access_request_email must be a valid email address."
  }
}

variable "app_service_sku_name" {
  description = "App Service plan SKU. F1 is free but has daily compute limits and no Always On support."
  type        = string
  default     = "F1"
}

variable "sql_admin_login" {
  description = "Administrator login name for Azure SQL. The password is generated by Terraform."
  type        = string
  default     = "winstonadmin"
}

variable "receipt_container_name" {
  description = "Blob container used for uploaded receipt images."
  type        = string
  default     = "receipts"
}

variable "github_repository" {
  description = "GitHub repository permitted to deploy WINSTON through workload identity federation."
  type        = string
  default     = "matthewbfarnsworth/WINSTON"

  validation {
    condition     = can(regex("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", var.github_repository))
    error_message = "github_repository must use the owner/repository format."
  }
}

variable "github_environment" {
  description = "GitHub environment whose workflows may request the Azure deployment identity."
  type        = string
  default     = "production"

  validation {
    condition     = can(regex("^[A-Za-z0-9_.-]+$", var.github_environment))
    error_message = "github_environment may contain letters, numbers, periods, underscores, and hyphens."
  }
}

variable "tags" {
  description = "Additional tags to apply to Azure resources."
  type        = map(string)
  default     = {}
}
